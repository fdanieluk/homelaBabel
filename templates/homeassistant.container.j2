[Unit]
Description=Home Assistant

[Container]
ContainerName=homeassistant
Image={{ homeassistant_image }}
AutoUpdate=registry
Network=host
Volume=%h/homeassistant:/config:Z
# Movies and shows, read-only, only to measure folder sizes (packages/dyski.yaml)
Volume={{ media_path }}:/media/biblioteka:ro,z
Volume=/etc/localtime:/etc/localtime:ro

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy=default.target
