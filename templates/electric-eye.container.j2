[Unit]
Description=electric-eye smart home controller

[Container]
ContainerName=electric-eye
Image={{ electric_eye_image }}
PublishPort=8000:8000
EnvironmentFile=%h/electric-eye/.env
Volume=%h/electric-eye/devices.toml:/app/devices.toml:ro,Z

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy=default.target
